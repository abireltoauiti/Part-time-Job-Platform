{% extends 'base.html.twig' %}

{% block title %}Create Job{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/job.css') }}">
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card shadow-lg rounded-lg border-0 card-job">
                    <div class="card-header text-white text-center py-3">
                        <h1 class="create-job-title">Create new Job</h1>
                    </div>
                    <div class="card-body">

                        {# Alert pour les erreurs globales #}
                        {% if not form.vars.valid %}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <strong>Form errors:</strong>
                                <ul class="mb-0">
                                    {% for error in form.vars.errors %}
                                        <li>{{ error.message }}</li>
                                    {% endfor %}
                                </ul>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endif %}

                        {{ form_start(form, {'attr': {'id': 'jobForm'}}) }}

                        <div class="mb-3">
                            {{ form_label(form.titre, 'Job Title') }}
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Enter job title'}}) }}
                            {{ form_errors(form.titre) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.description, 'Description') }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Enter job description'}}) }}
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.localisation, 'Location') }}
                            {{ form_widget(form.localisation, {'attr': {'class': 'form-control', 'placeholder': 'Enter job location'}}) }}
                            {{ form_errors(form.localisation) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.salaire, 'Salary') }}
                            {{ form_widget(form.salaire, {'attr': {'class': 'form-control', 'placeholder': 'Enter salary'}}) }}

                            {{ form_errors(form.salaire) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.dateLimite, 'Deadline') }}
                            {{ form_widget(form.dateLimite, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.dateLimite) }}
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a href="{{ path('job_index') }}" class="btn btn-secondary btn-hover">Back to List</a>
                            <button type="submit" class="btn btn-primary btn-hover" id="submitBtn">
                                <span>Create Job</span>
                                <span class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
                            </button>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('jobForm');
            const submitBtn = document.getElementById('submitBtn');
            form.addEventListener('submit', function() {
                submitBtn.querySelector('span').textContent = 'Submitting...';
                submitBtn.querySelector('.spinner-border').classList.remove('d-none');
                submitBtn.disabled = true;
            });
        });
    </script>
{% endblock %}
