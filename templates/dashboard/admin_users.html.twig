{% extends 'dashboard/admin.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .table th, .table td {
            vertical-align: middle;
        }
        .badge {
            min-width: 70px;
        }
        .action-buttons {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }
        .action-buttons form {
            margin: 0;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container my-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Liste des utilisateurs</h1>
            <span class="badge bg-secondary">{{ users|length }} utilisateur(s)</span>
        </div>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {# Users table #}
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Email</th>
                            <th>Rôle(s)</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for user in users %}
                            <tr>
                                <td class="text-muted">#{{ user.id }}</td>
                                <td>
                                    <a href="{{ path('admin_user_profile', {id: user.id}) }}"
                                       class="text-decoration-none fw-semibold">
                                        {{ user.nom }}
                                    </a>
                                </td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% for role in user.roles %}
                                        <span class="badge bg-info text-dark">{{ role }}</span>
                                    {% endfor %}
                                </td>
                                <td>
                                        <span class="badge {{ user.isActive ? 'bg-success' : 'bg-danger' }}">
                                            {{ user.isActive ? 'Actif' : 'Bloqué' }}
                                        </span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        {# Activer / Désactiver #}
                                        <a href="{{ path('admin_toggle_user', {id: user.id}) }}"
                                           class="btn btn-sm {{ user.isActive ? 'btn-outline-warning' : 'btn-outline-success' }}"
                                           onclick="return confirm('Êtes-vous sûr de vouloir {{ user.isActive ? 'désactiver' : 'activer' }} cet utilisateur ?');"
                                           title="{{ user.isActive ? 'Désactiver' : 'Activer' }}">
                                            {{ user.isActive ? 'Désactiver' : 'Activer' }}
                                        </a>

                                        {# Supprimer #}
                                        <form action="{{ path('admin_delete_user', {id: user.id}) }}"
                                              method="POST"
                                              onsubmit="return confirm('⚠️ Attention ! Voulez-vous vraiment supprimer {{ user.nom }} ? Cette action est irréversible.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-user' ~ user.id) }}">
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Supprimer">
                                                Supprimer
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    Aucun utilisateur trouvé
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
