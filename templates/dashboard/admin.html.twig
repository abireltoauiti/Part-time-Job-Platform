<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Dashboard Admin{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { min-height: 100vh; display: flex; }
        .sidebar { width: 250px; background: #343a40; color: white; }
        .sidebar a { color: white; display: block; padding: 0.75rem 1rem; text-decoration: none; }
        .sidebar a:hover { background: #495057; }
        .content { flex: 1; padding: 2rem; }
    </style>
</head>
<body>
<div class="sidebar">
    <h4 class="p-3">Admin Panel</h4>
    <a href="{{ path('admin_users') }}">Utilisateurs</a>
    <a href="#">Jobs</a>
    <a href="#">Statistiques</a>
    <a href="#">Paramètres</a>
</div>
<div class="content">
    {% block body %}{% endblock %}
</div>
</body>
</html>
